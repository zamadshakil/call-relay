{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "call-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "CF_TURN_KEY_ID",
      "CF_TURN_API_TOKEN",
      "SIGNAL_TICKET_SECRET",
      "ENROLLMENT_INVITE",
      "FCM_CLIENT_EMAIL",
      "FCM_PRIVATE_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "CALL_RELAY_DB",
      "database_name": "calling-system",
      "database_id": "cb880c26-e4ca-4e37-961a-14ce68cdf865",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIRING_SIGNAL",
        "class_name": "PairingSignal"
      }
    ]
  },
  "exports": {
    "PairingSignal": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "PUSH_QUEUE",
        "queue": "call-relay-push"
      }
    ],
    "consumers": [
      {
        "queue": "call-relay-push",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "call-relay-push-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "FCM_PROJECT_ID": "call-relay-3dec7"
  },
  "env": {
    "staging": {
      "name": "call-relay-staging",
      "secrets": {
        "required": [
          "CF_TURN_KEY_ID",
          "CF_TURN_API_TOKEN",
          "SIGNAL_TICKET_SECRET",
          "ENROLLMENT_INVITE",
          "FCM_CLIENT_EMAIL",
          "FCM_PRIVATE_KEY"
        ]
      },
      "d1_databases": [
        {
          "binding": "CALL_RELAY_DB",
          "database_name": "call-relay-staging",
          "database_id": "9f39161a-777e-463b-a953-6f32b1e62a26",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PAIRING_SIGNAL",
            "class_name": "PairingSignal"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "PUSH_QUEUE",
            "queue": "call-relay-staging-push"
          }
        ],
        "consumers": [
          {
            "queue": "call-relay-staging-push",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "call-relay-staging-push-dlq"
          }
        ]
      },
      "vars": {
        "FCM_PROJECT_ID": "call-relay-3dec7"
      }
    }
  }
}
