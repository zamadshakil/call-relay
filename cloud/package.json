{
  "name": "call-relay-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "dev": "vite build && wrangler dev",
    "test": "vitest run --config vitest.config.ts",
    "types": "wrangler types",
    "secrets:prepare": "node scripts/prepare-production-secrets.mjs",
    "firebase:android-config": "node scripts/fetch-firebase-android-config.mjs",
    "providers:validate": "node scripts/validate-provider-credentials.mjs",
    "preflight:production": "node scripts/preflight-production.mjs",
    "db:local": "wrangler d1 migrations apply CALL_RELAY_DB --local",
    "deploy": "node scripts/preflight-production.mjs && vite build && wrangler deploy",
    "deploy:staging": "vite build --mode staging && wrangler deploy --env staging"
  },
  "dependencies": {
    "@paddle/paddle-js": "1.6.5",
    "@zxing/browser": "0.1.5",
    "firebase": "12.3.0",
    "jose": "6.2.10",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@types/node": "26.3.0",
    "@types/web-push": "3.6.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  },
  "packageManager": "pnpm@10.30.3"
}
